{
  "name": "react-native-live-island",
  "version": "0.1.1",
  "description": "Write-once Live Activities & Dynamic Island for React Native (pure TurboModule, no Expo): iOS ActivityKit + Android live notification / floating island",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "!src/__tests__",
    "ios",
    "ios-widget",
    "android/src",
    "android/build.gradle",
    "LiveIsland.podspec",
    "scripts",
    "docs",
    "react-native.config.js"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts*"
  },
  "keywords": [
    "react-native",
    "dynamic-island",
    "live-activity",
    "activitykit",
    "android",
    "turbo-module"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76",
    "react-native-safe-area-context": "*"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "react": "19.1.0",
    "react-native": "0.81.1",
    "react-native-safe-area-context": "^5.5.2",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  },
  "codegenConfig": {
    "name": "LiveIslandSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.liveisland"
    },
    "ios": {
      "modulesProvider": {
        "LiveIsland": "LiveIsland"
      }
    }
  }
}
